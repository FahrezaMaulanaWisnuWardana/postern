# Copy to .env and edit before `docker compose up -d`.
#
# The file is read by Docker Compose, not by the server binary directly.

# Public hostname for the sync service. Its DNS record must point at this
# machine, and ports 80 and 443 must be reachable for ACME.
YOURPM_DOMAIN=sync.example.com

# Generate with: openssl rand -hex 32
YOURPM_JWT_SECRET=replace-me-with-a-random-32-byte-hex-string

# "closed" after the first account exists. "open" lets anyone register.
YOURPM_REGISTRATION=closed

# Optional: seed the first account automatically. Leave empty to use the
# registration endpoint once, then close registration.
YOURPM_ADMIN_EMAIL=
YOURPM_ADMIN_PASSWORD=

# Optional: require a bearer token for /metrics, e.g. output of
# `openssl rand -hex 24`. Leave empty to keep metrics open to the proxy net.
YOURPM_METRICS_TOKEN=

# Optional: prune sync operations older than this many days. 0 keeps all.
# Devices offline longer than the window must re-link.
YOURPM_OP_RETENTION_DAYS=0

YOURPM_VERSION=0.1.0
